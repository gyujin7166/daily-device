{
  "name": "daily-device",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "chromatic": "chromatic",
    "start": "next start",
    "db:seed": "ts-node prisma/seeds/seeds.ts",
    "db:seed:category": "ts-node prisma/seeds/seed-product-category.ts",
    "db:seed:hero": "ts-node prisma/seeds/seed-hero.ts",
    "db:seed:home": "ts-node prisma/seeds/seed-home-section.ts",
    "db:seed:i18n:color": "ts-node prisma/seeds/seed-color-i18n.ts",
    "db:seed:i18n": "ts-node prisma/seeds/seed-i18n.ts",
    "db:seed:i18n:product-category": "ts-node prisma/seeds/seed-product-category-i18n.ts",
    "db:seed:i18n:product-detail": "ts-node prisma/seeds/seed-product-detail-i18n.ts",
    "db:prepare:e2e": "ts-node scripts/prepareE2EDatabase.ts",
    "upload:seed-images": "ts-node prisma/seeds/upload-seed-images.ts",
    "test": "vitest --project unit",
    "test:unit": "vitest run --project unit",
    "test:storybook": "vitest run --project storybook-light --project storybook-dark",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:visual": "playwright test --grep @visual --pass-with-no-tests",
    "test:all": "npm run test:unit && npm run test:e2e",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@fal-ai/client": "^1.10.1",
    "@hookform/resolvers": "^5.7.1",
    "@prisma/client": "6.17.0",
    "@swc/helpers": "^0.5.23",
    "@tabler/icons-react": "^3.44.0",
    "@tanstack/react-query": "^5.100.11",
    "@tanstack/react-query-devtools": "^5.100.11",
    "@tidbcloud/prisma-adapter": "6.17.0",
    "@tidbcloud/serverless": "^0.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "next": "^16.2.6",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "^4.13.1",
    "react": "^19.2.6",
    "react-daum-postcode": "^4.0.0",
    "react-dom": "^19.2.6",
    "react-error-boundary": "^6.1.1",
    "react-hook-form": "^7.84.0",
    "react-toastify": "^11.1.0",
    "react-transition-group": "^4.4.5",
    "server-only": "^0.0.1",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@storybook/addon-a11y": "^10.5.7",
    "@storybook/addon-docs": "^10.5.7",
    "@storybook/addon-themes": "^10.5.7",
    "@storybook/addon-vitest": "10.5.7",
    "@storybook/nextjs-vite": "^10.5.7",
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.19.41",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-transition-group": "^4.4.12",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/browser-playwright": "4.1.9",
    "chromatic": "^18.2.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.6",
    "eslint-plugin-import": "^2.32.0",
    "jsdom": "^29.1.1",
    "msw": "^2.14.6",
    "msw-storybook-addon": "^3.0.0",
    "postcss": "^8.5.15",
    "prettier": "^3.8.3",
    "prisma": "6.17.0",
    "storybook": "^10.5.7",
    "tailwindcss": "^4.3.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  },
