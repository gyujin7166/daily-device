{
  "name": "daily-device",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:seed": "ts-node prisma/seeds/seeds.ts",
    "db:seed:category": "ts-node prisma/seeds/seed-product-category.ts",
    "db:seed:hero": "ts-node prisma/seeds/seed-hero.ts",
