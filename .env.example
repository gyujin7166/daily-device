# Database
DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/DATABASE?sslaccept=strict"
# Prisma connection mode: serverless (default) or direct
DATABASE_CONNECTION_MODE="serverless"

# Dedicated non-production database for Playwright E2E in CI
PLAYWRIGHT_DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/daily_device_e2e?sslaccept=strict"

# Auth.js / NextAuth
AUTH_SECRET="replace-with-a-random-secret"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
AUTH_DEBUG="false"

# OAuth providers
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_NAVER_ID=""
AUTH_NAVER_SECRET=""
AUTH_KAKAO_ID=""
AUTH_KAKAO_SECRET=""

# Demo login
DEMO_USER_EMAIL="demo@daily-device.local"
DEMO_USER_NAME="Demo User"

# API
NEXT_PUBLIC_API_URL=""

# Image upload
# NEXT_PUBLIC_* values are exposed to the browser. Never put secrets in them.
# Use CLOUDINARY_API_SECRET, or provide CLOUDINARY_URL instead.
CLOUDINARY_URL="cloudinary://API_KEY:API_SECRET@CLOUD_NAME"
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_API_KEY=""
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=""
NEXT_PUBLIC_CLOUDINARY_REVIEW_UPLOAD_PRESET="ecommerce_reviews"
NEXT_PUBLIC_CLOUDINARY_HERO_UPLOAD_PRESET="ecommerce_heroes"
NEXT_PUBLIC_CLOUDINARY_PRODUCT_UPLOAD_PRESET="ecommerce_products"
CLOUDINARY_UPLOAD_FOLDER_PREFIX="ecommerce"
CLOUDINARY_SEED_FOLDER_PREFIX=""

# Seed image pipeline
SEED_IMAGE_ROOT=".seed-images"
SEED_IMAGE_MANIFEST_PATH=""
SEED_MAIN_HERO_IMAGE_URL=""
SEED_PRODUCT_ALL_HERO_IMAGE_URL=""
SEED_PRODUCT_DISCOUNTS_HERO_IMAGE_URL=""

# Toss Payments
NEXT_PUBLIC_TOSS_CLIENT_KEY=""
TOSS_SECRET_KEY=""
